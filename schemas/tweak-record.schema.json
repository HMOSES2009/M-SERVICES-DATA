{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-SERVICES tweak plaintext record (pre-encryption)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "operator",
    "host",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "payload": {
      "type": "string",
      "maxLength": 8192
    },
    "sni": {
      "type": "string",
      "maxLength": 253
    },
    "dns": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253
      },
      "maxItems": 8
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "protocol": {
      "type": "string",
      "maxLength": 40
    },
    "parameters": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  }
}
